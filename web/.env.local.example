NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Sepolia is off for the local demo. Leave this empty. Exactly 1 turns Sepolia on, and only together with a
# Sepolia entry in src/contracts/deployments.json (see the Sepolia runbook in the root README.md).
# NEXT_PUBLIC_ENABLE_SEPOLIA=
# Keyless RPC URL only: every NEXT_PUBLIC_ value is bundled into the page and public. Empty uses viem's default.
# NEXT_PUBLIC_SEPOLIA_RPC_URL=
# Never put DEPLOYER_PRIVATE_KEY in this file or in any NEXT_PUBLIC_ variable. Set it in your shell only.
